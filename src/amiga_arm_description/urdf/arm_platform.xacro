<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Two planks screwed together at 90 degrees, with a UFactory arm (robot: lite6 or xarm6).
       platform_link origin: top front edge of the Amiga cross tube the top plank rests on.
       Geometry and arm pose come from config/arm_platform.yaml. -->
  <xacro:macro name="arm_platform" params="parent xyz rpy config robot arm_key gripper ros2_control_plugin robot_ip">
    <xacro:property name="cfg" value="${xacro.load_yaml(config)}"/>
    <xacro:property name="plank" value="${cfg['platform']['plank']}"/>
    <xacro:property name="L" value="${plank['length']}"/>
    <xacro:property name="W" value="${plank['width']}"/>
    <xacro:property name="T" value="${plank['thickness']}"/>
    <xacro:property name="arm" value="${cfg[arm_key]}"/>

    <material name="plank_wood">
      <color rgba="0.76 0.60 0.42 1.0"/>
    </material>

    <xacro:macro name="plank_box" params="origin size">
      <visual>
        <origin xyz="${origin}"/>
        <geometry><box size="${size}"/></geometry>
        <material name="plank_wood"/>
      </visual>
      <collision>
        <origin xyz="${origin}"/>
        <geometry><box size="${size}"/></geometry>
      </collision>
    </xacro:macro>

    <link name="platform_link">
      <!-- Top plank: flat on the cross tube, front edge flush with the vertical plank's front face. -->
      <xacro:plank_box origin="${T - W/2} 0 ${T/2}" size="${W} ${L} ${T}"/>
      <!-- Vertical plank: hangs under the top plank's front edge, against the cross tube's front face. -->
      <xacro:plank_box origin="${T/2} 0 ${-W/2}" size="${T} ${L} ${W}"/>
      <inertial>
        <origin xyz="${T/2 - W/4} 0 ${T/2 - W/4}"/>
        <mass value="3.0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Collide bit 0 only: the planks touch the soil and the Amiga, but no pixelfield Plant
         (robot interface 2), so they neither pick nor crush Plants under the platform. -->
    <gazebo reference="platform_link">
      <collision><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
    </gazebo>

    <!-- The arm links as well: leaves push only on the gripper. Arm links in a dense bed pick
         and push dozens of Plants, which slows the simulation down to a few percent of real time. -->
    <xacro:macro name="soil_only" params="link">
      <gazebo reference="${link}">
        <collision><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision>
      </gazebo>
    </xacro:macro>
    <xacro:soil_only link="link1"/>
    <xacro:soil_only link="link2"/>
    <xacro:soil_only link="link3"/>
    <xacro:soil_only link="link4"/>
    <xacro:soil_only link="link5"/>
    <xacro:soil_only link="link6"/>

    <joint name="platform_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="platform_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>
    <xacro:xarm_device robot_type="${'lite' if robot == 'lite6' else 'xarm'}" dof="6"
      attach_to="platform_link" create_attach_link="false"
      attach_xyz="${' '.join(map(str, arm['xyz']))}"
      attach_rpy="${' '.join(map(str, arm['rpy']))}"
      ros2_control_plugin="${ros2_control_plugin}" load_gazebo_plugin="true"
      ros2_control_params="${'$(find amiga_arm_description)/config/sim_controllers.yaml' if gripper else ''}"
      robot_ip="${robot_ip}"/>

    <!-- Gripper, not through xarm's add_gripper: that one makes the fingers follow each other
         through a Gazebo Classic style plugin that does not load in gz sim, and its position
         control did not move the fingers reliably. Here both fingers are effort controlled, so
         each squeezes with the commanded force, capped by its joint effort limit. They close
         independently: gz_ros2_control's mimic did not follow an effort controlled finger, and a
         velocity controlled one squeezed only as hard as the leaves resisted its speed.
         lite6: xarm's Gripper Lite links (5 N). xarm6: the xArm Gripper as parallel jaws (30 N). -->
    <xacro:if value="${gripper}">
      <xacro:include filename="$(find xarm_description)/urdf/common/common.link.xacro"/>
      <xacro:if value="${robot == 'lite6'}">
        <xacro:include filename="$(find xarm_description)/urdf/gripper/uflite_gripper.urdf.xacro"/>
        <xacro:uflite_gripper_urdf attach_to="link_eef"/>
      </xacro:if>
      <xacro:if value="${robot == 'xarm6'}">
        <xacro:include filename="$(find amiga_arm_description)/urdf/xarm_gripper_jaws.xacro"/>
        <xacro:xarm_gripper_jaws attach_to="link_eef"/>
      </xacro:if>
      <xacro:if value="${ros2_control_plugin == 'gz_ros2_control/GazeboSimSystem'}">
        <ros2_control name="GripperSystem" type="system">
          <hardware><plugin>${ros2_control_plugin}</plugin></hardware>
          <!-- mimic="false": the gripper URDFs make finger_joint2 mimic finger_joint1 -->
          <xacro:macro name="finger_joint" params="name">
            <joint name="${name}" mimic="false">
              <command_interface name="effort"/>
              <state_interface name="position"/>
              <state_interface name="velocity"/>
            </joint>
          </xacro:macro>
          <xacro:finger_joint name="finger_joint1"/>
          <xacro:finger_joint name="finger_joint2"/>
        </ros2_control>
      </xacro:if>
    </xacro:if>
  </xacro:macro>

</robot>
